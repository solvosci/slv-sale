<odoo>

    <record id="stock_move_pending_menu_tree" model="ir.ui.view">
        <field name="name">stock.move.tree (in sale_order_pending_move_menu_wspsa)</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="sale_order_pending_move_menu.stock_move_pending_menu_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="move_website_partner_ref" />
            </xpath>
        </field>
    </record>

    <record id="view_move_search" model="ir.ui.view">
        <field name="name">stock.move.search (in sale_order_pending_move_menu_wspsa)</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="move_website_partner_ref" />
            </xpath>
        </field>
    </record>

</odoo>
