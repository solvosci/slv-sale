<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form (in sale_order_line_copy)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pricelist_id']" position="after">
                <field name="custom_rate_enabled_visible" invisible="1" />
                <field
                    name="custom_rate_enabled"
                    widget="boolean_toogle"
                    attrs="{'invisible': [('custom_rate_enabled_visible', '=', False)]}"
                />
                <field
                    name="custom_rate"
                    string="Custom Rate"
                    placeholder="Custom Rate"
                    attrs="{'invisible': [('custom_rate_enabled', '=', False)]}"
                />                
            </xpath>
        </field>
    </record>
</odoo>
