<odoo>

    <template id="report_picking" inherit_id="stock.report_picking">
        <xpath expr="//th[@name='th_product']" position="after">
            <t t-set="display_color" t-value="any(line.sudo().color_code_tintometric for line in o.move_ids_without_package)"/>
            <t t-if="display_color">
                <th name="color_code_tintometric"><strong>Lot/S.Tin</strong></th>
            </t>
        </xpath>
        <xpath expr="//span[@t-field='ml.product_id.display_name']/.." position="after">
            <t t-if="display_color">
                <t t-if="ml.move_id.color_code_tintometric">
                    <td>
                        <span t-field="ml.move_id.color_code_tintometric"/>
                    </td>
                </t>
                <t t-else="">
                    <td>
                        <span></span>
                    </td>
                </t>
            </t>
        </xpath>
        
    </template>

</odoo>
