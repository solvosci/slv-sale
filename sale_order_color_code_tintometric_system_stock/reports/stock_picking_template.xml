<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <!-- state != done -->
        <xpath expr="//th[@name='th_sm_ordered']" position="before">
            <t t-set="display_color" t-value="any(line.sudo().color_code_tintometric for line in o.move_ids_without_package)"/>
            <t t-if="display_color">
                <th name="color_code_tintometric"><strong>Lot/S.Tin</strong></th>
            </t>
        </xpath>
        <xpath expr="//span[@t-field='move.product_id']/.." position="after">
            <t t-if="display_color">
                <t t-if="move.sudo().color_code_tintometric">
                    <td>
                        <span t-field="move.color_code_tintometric"/>
                    </td>
                </t>
                <t t-else="not move.color_code_tintometric">
                    <td name="color_code_tintometric"/>
                </t>
            </t>
        </xpath>
        <!-- state == done -->
        <xpath expr="//th[@name='th_sml_product']" position="after">
            <t t-set="display_color" t-value="any(line.sudo().color_code_tintometric for line in o.move_ids_without_package)"/>
            <t t-if="display_color">
                <th name="color_code_tintometric"><strong>Lot/S.Tin</strong></th>
            </t>
        </xpath>
    </template>

    <!-- if product has serial number -->
    <template id="stock_report_delivery_has_serial_move_line" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//span[@t-field='move_line.product_id']" position="after">
            <t t-set="display_color" t-value="any(line.sudo().color_code_tintometric for line in o.move_ids_without_package)"/>
            <t t-if="display_color">
                <t t-if="move_line.move_id.color_code_tintometric">
                    <td>
                        <span t-field="move_line.move_id.color_code_tintometric"/>
                    </td>
                </t>
                <t t-else="">
                    <td>
                        <span></span>
                    </td>
                </t>
            </t>
        </xpath>
    </template>

    <template id="stock_report_delivery_aggregated_move_lines" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_qty_ordered']" position="before">
            <t t-set="display_color" t-value="any(line.sudo().color_code_tintometric for line in o.move_ids_without_package)"/>
            <t t-if="display_color">
                <t t-if="move_line.move_id.color_code_tintometric">
                    <td>
                        <span t-field="move_line.move_id.color_code_tintometric"/>
                        <span></span>
                    </td>
                </t>
                <t t-else="">
                    <td>
                        <span></span>
                    </td>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
