<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form (in sale_order_partner_data_security)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_invoice_id']" position="before">
                <field name="is_partner_editor" invisible="1"/> 
            </xpath>
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="readonly">partner_invoice_id and not is_partner_editor</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly">partner_shipping_id and not is_partner_editor</attribute>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="readonly">pricelist_id and not is_partner_editor</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">payment_term_id and not is_partner_editor</attribute>
            </xpath>

            <xpath expr="//group[@name='sales_person']//field[@name='user_id']" position="attributes">
                <attribute name="readonly">user_id and not is_partner_editor</attribute>
            </xpath>
            <xpath expr="//group[@name='sales_person']//field[@name='team_id']" position="attributes">
                <attribute name="readonly">team_id and not is_partner_editor</attribute>
            </xpath>
            <xpath expr="//group[@name='sales_person']//field[@name='company_id']" position="attributes">
                <attribute name="readonly">company_id and not is_partner_editor</attribute>
            </xpath>

            <xpath expr="//group[@name='sale_info']//field[@name='fiscal_position_id']" position="attributes">
                <attribute name="readonly">fiscal_position_id and not is_partner_editor</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info']//field[@name='journal_id']" position="attributes">
                <attribute name="readonly">journal_id and not is_partner_editor</attribute>
            </xpath>
        </field>
    </record> 

</odoo>
