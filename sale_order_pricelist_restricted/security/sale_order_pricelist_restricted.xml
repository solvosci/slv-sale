<odoo noupdate="1">
    <record id="product_pricelist_my_pricelists_rule" model="ir.rule">
        <field name="name">Pricelist - see only my pricelists and public ones</field>
        <field name="model_id" ref="product.model_product_pricelist" />
        <field
            name="domain_force"
        >[
            '|', 
                ('sale_order_selectable', '=', True),
                '|',
                    ('salesman_user_ids', '=', user.id),
                    ('sale_order_exclusive_partner_id.user_id', '=', user.id),
        ]</field>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
        <field
            name="groups"
            eval="[(4, ref('sales_team.group_sale_salesman'))]"
        />
    </record>
    <record id="product_pricelist_all_pricelists_rule" model="ir.rule">
        <field name="name">Pricelist - access all pricelists</field>
        <field name="model_id" ref="product.model_product_pricelist" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
        <field
            name="groups"
            eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"
        />
    </record>

    <record id="product_pricelist_item_my_pricelists_rule" model="ir.rule">
        <field name="name">Pricelist Items - see only my pricelists and public ones</field>
        <field name="model_id" ref="product.model_product_pricelist_item" />
        <field
            name="domain_force"
        >[
            '|', 
                ('pricelist_id.sale_order_selectable', '=', True),
                '|',
                    ('pricelist_id.salesman_user_ids', '=', user.id),
                    ('pricelist_id.sale_order_exclusive_partner_id.user_id', '=', user.id),
        ]</field>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
        <field
            name="groups"
            eval="[(4, ref('sales_team.group_sale_salesman'))]"
        />
    </record>
    <record id="product_pricelist_item_all_pricelists_rule" model="ir.rule">
        <field name="name">Pricelist Items - access all pricelists</field>
        <field name="model_id" ref="product.model_product_pricelist_item" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_write"/>
        <field eval="0" name="perm_create"/>
        <field eval="0" name="perm_unlink"/>
        <field
            name="groups"
            eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"
        />
    </record>
</odoo>
