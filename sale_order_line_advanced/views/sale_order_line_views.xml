<odoo>
    <record id="view_order_line_tree" model="ir.ui.view">
        <field name="name">sale.order.line.form</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">true</attribute>
            </xpath>
            <xpath expr="//field[@name='order_id']" position="after">
                <field name="date_order" optional="hiden"/>
                <field name="last_update_order" optional="hiden"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_line_filter" model="ir.ui.view">
        <field name="name">sale.order.line.search</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group">
                <filter string="Date Order" name="date_order" domain="[]" context="{'group_by':'date_order'}"/>
                <filter string="Last Update Order" name="last_update_order" domain="[]" context="{'group_by':'last_update_order'}"/>
            </xpath>
        </field>
    </record>

</odoo>
