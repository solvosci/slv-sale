<odoo>
    <record id="sale_order_line_view_tree" model="ir.ui.view">
        <field name="name">sale.order.view.tree</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale_order_line_menu.sale_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="color_code_tintometric" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_search" model="ir.ui.view">
        <field name="name">sale.order.line.search</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale_order_line_menu.sale_order_line_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='salesman_id']" position="after">
                <field name="color_code_tintometric" />
            </xpath>
            <xpath expr="//group//filter[@name='groupby_date_order']" position="after">
                <filter name="groupby_color_code_tintometric" string="Lot/S.Tin" context="{'group_by': 'color_code_tintometric'}" />
            </xpath>
        </field>
    </record>
</odoo>
