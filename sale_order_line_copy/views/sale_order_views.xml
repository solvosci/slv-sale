<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form (in sale_order_line_copy)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']//tree/field[@name='product_id']" position="before">
                <button
                    type="object" 
                    name="copy_sol" 
                    class="fa fa-copy"
                    aria-label="Copy line" 
                    confirm="Are you sure you want to copy this order line?"
                    style="padding: 0; height: auto; width: auto; display: inline-block;"
                    attrs="{'invisible': [('state', 'in', ['cancel', 'done'])]}">
                    <i class="fa fa-copy" style="vertical-align: top;"></i>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
