<odoo>

    <record id="stock_move_pending_menu_tree" model="ir.ui.view">
        <field name="name">stock.move.tree (in sale_order_pending_move_menu_sds)</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="sale_order_pending_move_menu.stock_move_pending_menu_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_warehouse_id']" position="after">
                <field name="move_delivery_status" widget="badge"/>
            </xpath>
        </field>
    </record>

</odoo>
