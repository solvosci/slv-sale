<odoo>
    <record id="view_order_line_tree" model="ir.ui.view">
        <field name="name">sale.order.line.view.form</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user'))]" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_id']" position="after">
                <field name="batch_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_line_filter" model="ir.ui.view">
        <field name="name">sale.order.line.search</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user'))]" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='salesman_id']" position="after">
                <field name="batch_ids" />
            </xpath>
        </field>
    </record>

</odoo>
