<odoo>

    <record id="action_pending_stock_move_menu" model="ir.actions.act_window">
        <field name="name">Pending Sale Moves</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">tree</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('stock_move_pending_menu_tree')})]"/>
        <field name="search_view_id" ref="stock_move_pending_menu_search"/>
        <field name="domain">
        [
            ('state', 'not in', ['done','cancel']),
            ('picking_id.picking_type_code', '=', 'outgoing'),
            ('sale_line_id', '!=', False)
        ]
        </field>
        <field name="context">{
            "search_default_last_10_days": True,
        }</field>
    </record>

    <menuitem
        id="menu_sale_order_pending_moves"
        name="Pending Sale Moves"
        action="action_pending_stock_move_menu"
        parent="sale.sale_order_menu"
        sequence="25"
        groups="sales_team.group_sale_manager"
    />

</odoo>
